# Public origin of the site, no trailing slash. REQUIRED for production builds (on Vercel it defaults
# to the project's production domain): every canonical, hreflang, sitemap, og:url and llms.txt link is built from it.
SITE_URL=https://loophome.ae

# Backend API root (server side and the /api/v1 rewrite). Production default: https://loophome-be.onrender.com/api/v1
API_URL=http://localhost:5000/api/v1

# Optional: Google Search Console HTML-tag verification code.
GOOGLE_SITE_VERIFICATION=

# Shared secret sent as x-internal-key so the API doesn't rate-limit this server
# (all server-side rendering reaches the API from one IP). Must equal the API's INTERNAL_API_KEY
# and be at least 32 characters (the API refuses to start otherwise), e.g. `openssl rand -hex 32`.
INTERNAL_API_KEY=
